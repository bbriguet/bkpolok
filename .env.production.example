# Copy to .env on the VPS or enter these values in Hostinger's environment settings.
# Replace every example value. Never commit the populated .env file.
SITE_DOMAIN=example.ch
SECRET_KEY=change-me-generate-a-random-production-key
ALLOWED_HOSTS=example.ch,www.example.ch
CSRF_TRUSTED_ORIGINS=https://example.ch,https://www.example.ch
WAGTAILADMIN_BASE_URL=https://example.ch

POSTGRES_DB=bkpolok
POSTGRES_USER=bkpolok
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Keep HSTS disabled until HTTPS is confirmed; then set to 2592000.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Fill these in to enable contact-form email delivery.
EMAIL_HOST=smtp.infomaniak.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=