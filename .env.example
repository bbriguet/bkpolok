# Copier vers .env (non commité) et adapter.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Utilisées par le service db et pour construire DATABASE_URL dans docker-compose.yml
POSTGRES_DB=bkpolok
POSTGRES_USER=bkpolok
POSTGRES_PASSWORD=change-me

# Hors Docker uniquement (docker-compose.yml calcule DATABASE_URL lui-même)
# DATABASE_URL=postgres://bkpolok:change-me@localhost:5433/bkpolok

# Production
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://exemple.ch
# WAGTAILADMIN_BASE_URL=https://exemple.ch
# Email du formulaire de contact (SMTP, production ; en dev les emails s'affichent dans la console)
# EMAIL_HOST=smtp.example.ch
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@exemple.ch
